{
  "manifest_version": 3,
  "name": "Hold for 2x",
  "version": "2.5.0",
  "description": "Press and hold on any video to play it at 2x. Let go to go back to normal speed.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Hold for 2x",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
